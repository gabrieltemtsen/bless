# Optional: Upstash Redis credentials for persistent chain storage.
# Without these, the app uses an in-memory store (great for local dev,
# but resets between serverless cold starts on Vercel).
#
# Create a free Redis db at https://console.upstash.com → copy the
# REST URL and REST TOKEN here, then set them as env vars in Vercel too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public URL where this miniapp is deployed.
# Used only for the README og:image and submission metadata.
NEXT_PUBLIC_APP_URL=https://bless.example.com
